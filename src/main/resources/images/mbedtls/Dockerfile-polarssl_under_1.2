FROM alpine-build:3.12 as polarssl-base1
ARG VERSION
RUN wget -O mbed.tgz https://github.com/Mbed-TLS/mbedtls/archive/refs/tags/polarssl-${VERSION}.tar.gz
RUN mkdir mbed
RUN tar -xzf mbed.tgz -C mbed --strip-components 1
WORKDIR /build/
RUN cmake -DCMAKE_BUILD_TYPE=Release /src/mbed &&\
  make

FROM entrypoint as polarssl-base2
COPY --from=polarssl-base1 /lib/ld-musl-x86_64.so.* /lib/

FROM polarssl-base2 as polarssl-server
ARG VERSION
LABEL "tls_implementation"="mbedtls"
LABEL "tls_implementation_version"="${VERSION}"
LABEL "tls_implementation_connectionRole"="server"
COPY --from=polarssl-base1 /build/programs/ssl/ssl_server /bin/
ENTRYPOINT ["server-entrypoint", "ssl_server"]

FROM polarssl-base2 as polarssl-client
ARG VERSION
LABEL "tls_implementation"="mbedtls"
LABEL "tls_implementation_version"="${VERSION}"
LABEL "tls_implementation_connectionRole"="client"
COPY --from=polarssl-base1 /build/programs/ssl/ssl_client2 /bin/
ENTRYPOINT ["client-entrypoint", "ssl_client2"]
